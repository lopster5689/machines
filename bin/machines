#!/usr/bin/env python3
"""Fleet manager: generate ssh config from machines.yaml, and inspect the fleet.

Subcommands:
  sync    regenerate ~/.ssh/config.d/machines from machines.yaml
  ls      table of every machine in the inventory
  ping    TCP-connect each machine's ssh port to see what is alive
  audit   ssh into each active machine and report hostname/uptime/disk/docker
"""

import argparse
import concurrent.futures
import os
import socket
import subprocess
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
INVENTORY = ROOT / "machines.yaml"
OUT = Path.home() / ".ssh" / "config.d" / "machines"

# status values that still get an ssh config entry
EMITTED = {"active", "offline"}

BANNER = """# GENERATED BY `make sync` - DO NOT EDIT.
# Source of truth: {src}
# Edit that file and re-run `make sync`.
"""


def load():
    with INVENTORY.open() as fh:
        doc = yaml.safe_load(fh)
    defaults = doc.get("defaults") or {}
    machines = doc.get("machines") or {}
    return defaults, machines


def resolve_key(key):
    """Relative key paths are relative to the repo; ~ and / are left alone."""
    if key.startswith("~") or key.startswith("/"):
        return key
    return str(ROOT / key)


def ssh_port(m):
    return int(m.get("port", 22))


def cmd_sync(args):
    defaults, machines = load()
    default_user = defaults.get("user")
    default_opts = defaults.get("options") or {}

    blocks, skipped = [], []
    for name, m in machines.items():
        status = m.get("status", "active")
        if status not in EMITTED:
            skipped.append((name, status))
            continue

        names = " ".join([name] + list(m.get("aliases") or []))
        lines = [f"Host {names}"]
        if m.get("note"):
            lines.append(f"  # {m['note']}")
        lines.append(f"  HostName {m['host']}")
        lines.append(f"  User {m.get('user', default_user)}")
        if m.get("key"):
            lines.append(f"  IdentityFile {resolve_key(m['key'])}")
            # only offer this key, do not walk the agent through every identity
            lines.append("  IdentitiesOnly yes")
        if m.get("port"):
            lines.append(f"  Port {m['port']}")
        if m.get("proxy_command"):
            lines.append(f"  ProxyCommand {m['proxy_command']}")

        opts = dict(default_opts)
        opts.update(m.get("options") or {})
        for k, v in opts.items():
            lines.append(f"  {k} {v}")

        blocks.append("\n".join(lines))

    body = BANNER.format(src=INVENTORY) + "\n" + "\n\n".join(blocks) + "\n"

    OUT.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(OUT.parent, 0o700)
    tmp = OUT.with_suffix(".tmp")
    tmp.write_text(body)
    os.chmod(tmp, 0o600)
    tmp.replace(OUT)

    print(f"wrote {OUT}  ({len(blocks)} hosts, {len(skipped)} skipped)")
    for name, status in skipped:
        print(f"  skipped {name} (status: {status})")
    return 0


def cmd_ls(args):
    _, machines = load()
    rows = []
    for name, m in machines.items():
        if args.status and m.get("status", "active") != args.status:
            continue
        rows.append((
            name,
            m.get("provider", "-"),
            str(m["host"]),
            m.get("status", "active"),
            (m.get("purpose") or "-")[:44],
        ))
    if not rows:
        print("no machines match")
        return 0
    widths = [max(len(r[i]) for r in rows + [("NAME", "PROVIDER", "HOST", "STATUS", "PURPOSE")])
              for i in range(5)]
    fmt = "  ".join(f"{{:<{w}}}" for w in widths)
    print(fmt.format("NAME", "PROVIDER", "HOST", "STATUS", "PURPOSE"))
    for r in rows:
        print(fmt.format(*r))
    print(f"\n{len(rows)} machines")
    return 0


def probe(name, m, timeout):
    host, port = m["host"], ssh_port(m)
    if m.get("proxy_command"):
        # reached through a proxy, never by direct TCP - a connect test here
        # would always report DOWN and mean nothing
        return name, host, port, None, "proxied"
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return name, host, port, True, ""
    except Exception as exc:  # noqa: BLE001 - any failure means unreachable
        return name, host, port, False, type(exc).__name__


def cmd_ping(args):
    _, machines = load()
    targets = {n: m for n, m in machines.items()
               if m.get("status", "active") in EMITTED}
    with concurrent.futures.ThreadPoolExecutor(max_workers=24) as pool:
        results = list(pool.map(lambda kv: probe(kv[0], kv[1], args.timeout),
                                targets.items()))

    up = [r for r in results if r[3] is True]
    down = [r for r in results if r[3] is False]
    skip = [r for r in results if r[3] is None]
    width = max((len(r[0]) for r in results), default=4)
    for name, host, port, _, _ in sorted(up):
        print(f"UP    {name:<{width}}  {host}:{port}")
    for name, host, port, _, err in sorted(down):
        note = targets[name].get("note", "")
        tail = f"  ({note})" if note else f"  [{err}]"
        print(f"DOWN  {name:<{width}}  {host}:{port}{tail}")
    for name, host, port, _, why in sorted(skip):
        print(f"n/a   {name:<{width}}  {host}  ({why} - direct TCP check does not apply)")
    print(f"\n{len(up)} up, {len(down)} down, {len(skip)} n/a, {len(results)} checked")
    return 0


AUDIT_CMD = (
    "echo \"host=$(hostname)\"; "
    "echo \"os=$(. /etc/os-release 2>/dev/null && echo $PRETTY_NAME)\"; "
    "echo \"uptime=$(uptime -p 2>/dev/null)\"; "
    "echo \"disk=$(df -h / | awk 'NR==2{print $3\"/\"$2\" (\"$5\")\"}')\"; "
    "echo \"docker=$(docker ps --format '{{.Names}}' 2>/dev/null | paste -sd, -)\"; "
    "echo \"vhosts=$(ls /etc/nginx/sites-enabled 2>/dev/null | paste -sd, -)\""
)


def audit_one(name, timeout):
    try:
        proc = subprocess.run(
            ["ssh", "-o", "BatchMode=yes",
             "-o", f"ConnectTimeout={timeout}",
             "-o", "StrictHostKeyChecking=accept-new",
             name, AUDIT_CMD],
            capture_output=True, text=True, timeout=timeout + 20,
        )
    except subprocess.TimeoutExpired:
        return name, False, "timed out"
    if proc.returncode != 0:
        return name, False, (proc.stderr.strip().splitlines() or ["failed"])[-1]
    return name, True, proc.stdout.strip()


def cmd_audit(args):
    _, machines = load()
    targets = [n for n, m in machines.items()
               if m.get("status", "active") == "active"]
    if args.only:
        targets = [n for n in targets if n in args.only]

    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        results = list(pool.map(lambda n: audit_one(n, args.timeout), targets))

    for name, ok, out in results:
        print(f"\n=== {name} ===")
        if not ok:
            print(f"  ERROR: {out}")
            continue
        for line in out.splitlines():
            print(f"  {line}")
    ok_n = sum(1 for _, ok, _ in results if ok)
    print(f"\n{ok_n}/{len(results)} reachable")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="machines")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("sync").set_defaults(fn=cmd_sync)

    p_ls = sub.add_parser("ls")
    p_ls.add_argument("--status", help="filter by status")
    p_ls.set_defaults(fn=cmd_ls)

    p_ping = sub.add_parser("ping")
    p_ping.add_argument("--timeout", type=float, default=4.0)
    p_ping.set_defaults(fn=cmd_ping)

    p_audit = sub.add_parser("audit")
    p_audit.add_argument("--timeout", type=int, default=10)
    p_audit.add_argument("--only", nargs="*", help="limit to these machine names")
    p_audit.set_defaults(fn=cmd_audit)

    args = ap.parse_args()
    sys.exit(args.fn(args))


if __name__ == "__main__":
    main()
